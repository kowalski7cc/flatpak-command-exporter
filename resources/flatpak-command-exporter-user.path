[Unit]
Description=Watch user Flatpak exports for command changes

[Path]
PathChanged=%h/.local/share/flatpak/exports/share/applications
PathChanged=%h/.local/share/flatpak/exports/share/dbus-1/services
PathChanged=%h/.local/share/flatpak/exports/share/gnome-shell/search-providers
PathChanged=%h/.local/share/flatpak/exports/share/krunner/dbusplugins
PathChanged=%h/.local/share/flatpak/exports/share/mime/packages
PathChanged=%h/.local/share/flatpak/exports/share/metainfo
Unit=flatpak-command-exporter-user.service

[Install]
WantedBy=default.target
