<component type="desktop-application">
  <id>xyz.kowalski7cc.flatpak-command-exporter</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Flatlink</name>
  <summary>Manage commands exported by installed Flatpak apps</summary>
  <developer id="xyz.kowalski7cc">
    <name>Kowalski Dragon</name>
  </developer>
  <description>
    <p>
      Flatlink helps you discover and manage command-line tools provided by
      installed Flatpak applications. It lets you choose which commands are
      available in your terminal, configure defaults, and create custom
      aliases.
    </p>
    <p>
      Built with GTK 4 and libadwaita, Flatlink provides an adaptive desktop
      interface for searching apps and commands, changing export settings, and
      refreshing exported commands.
    </p>
  </description>
  <launchable type="desktop-id">xyz.kowalski7cc.flatpak-command-exporter.desktop</launchable>
