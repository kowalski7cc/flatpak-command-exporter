msgid "The GUI requires PyGObject, GTK 4, and libadwaita with introspection data installed."
msgstr "L’interface nécessite PyGObject, GTK 4 et libadwaita avec les données d’introspection installées."

msgid "Exported Commands"
msgstr "Commandes exportées"

msgid "Export"
msgstr "Exporter"

msgid "Export all user commands"
msgstr "Exporter toutes les commandes utilisateur"

msgid "Main Menu"
msgstr "Menu principal"

msgid "Search apps and commands"
msgstr "Rechercher des applications et des commandes"

msgid "All apps"
msgstr "Toutes les applications"

msgid "User apps"
msgstr "Applications utilisateur"

msgid "System apps"
msgstr "Applications système"

msgid "Filter by Flatpak installation"
msgstr "Filtrer par installation Flatpak"

#, python-format
msgid "Show commands for %(app)s"
msgstr "Afficher les commandes de %(app)s"

msgid "User"
msgstr "Utilisateur"

msgid "System"
msgstr "Système"

#, python-format
msgid "%(app_id)s - %(branch)s (%(arch)s) - %(scope)s installation"
msgstr "%(app_id)s - %(branch)s (%(arch)s) - installation %(scope)s"

msgid "Enable or disable every exported command in this app"
msgstr "Activer ou désactiver toutes les commandes exportées de cette application"

#, python-format
msgid "Export commands for %(app)s"
msgstr "Exporter les commandes de %(app)s"

#, python-format
msgid "Export %(alias)s from %(app)s"
msgstr "Exporter %(alias)s depuis %(app)s"

msgid "No exported aliases"
msgstr "Aucun alias exporté"

msgid "No aliases found"
msgstr "Aucun alias trouvé"

msgid "No user aliases"
msgstr "Aucun alias utilisateur"

msgid "No system aliases"
msgstr "Aucun alias système"

msgid "Could not refresh user settings"
msgstr "Impossible d’actualiser les paramètres utilisateur"

msgid "Could not save alias setting"
msgstr "Impossible d’enregistrer le paramètre de l’alias"

msgid "Alias setting saved, but export failed"
msgstr "Paramètre de l’alias enregistré, mais l’export a échoué"

msgid "Could not save app command settings"
msgstr "Impossible d’enregistrer les paramètres des commandes de l’application"

msgid "App command settings saved, but export failed"
msgstr "Paramètres des commandes enregistrés, mais l’export a échoué"

msgid "Could not open settings"
msgstr "Impossible d’ouvrir les paramètres"

msgid "Could not export user commands"
msgstr "Impossible d’exporter les commandes utilisateur"

msgid "Remove custom alias"
msgstr "Supprimer l’alias personnalisé"

msgid "Remove custom alias?"
msgstr "Supprimer l’alias personnalisé ?"

msgid "This permanently removes the custom alias %(alias)s."
msgstr "Cette action supprime définitivement l’alias personnalisé %(alias)s."

msgid "Remove"
msgstr "Supprimer"

msgid "Could not confirm custom alias removal"
msgstr "Impossible de confirmer la suppression de l’alias personnalisé"

msgid "Could not remove custom alias"
msgstr "Impossible de supprimer l’alias personnalisé"

msgid "User commands exported"
msgstr "Commandes utilisateur exportées"

msgid "Settings"
msgstr "Paramètres"

msgid "Default export"
msgstr "Export par défaut"

msgid "Export new commands by default"
msgstr "Exporter les nouvelles commandes par défaut"

msgid "Applies to user commands, including commands from system apps."
msgstr "S’applique aux commandes utilisateur, y compris celles des applications système."

msgid "Reset to factory defaults"
msgstr "Rétablir les paramètres par défaut"

msgid "Restore the default export policy and clear app overrides."
msgstr "Rétablir la règle d’export par défaut et supprimer les dérogations des applications."

msgid "Reset"
msgstr "Réinitialiser"

msgid "Enabled app overrides"
msgstr "Dérogations d’applications activées"

msgid "Disabled app overrides"
msgstr "Dérogations d’applications désactivées"

msgid "Remove app override"
msgstr "Supprimer la dérogation de l’application"

msgid "Could not save app override"
msgstr "Impossible d’enregistrer la dérogation de l’application"

msgid "App override saved, but export failed"
msgstr "Dérogation de l’application enregistrée, mais l’export a échoué"

msgid "App override saved, but settings could not be refreshed"
msgstr "Dérogation de l’application enregistrée, mais les paramètres n’ont pas pu être actualisés"

msgid "Could not load installed app refs"
msgstr "Impossible de charger les références des applications installées"

msgid "Could not add app override"
msgstr "Impossible d’ajouter une dérogation pour l’application"

msgid "No installed Flatpak apps with exported commands were found"
msgstr "Aucune application Flatpak installée avec des commandes exportées n’a été trouvée"

msgid "Select an installed app"
msgstr "Sélectionner une application installée"

msgid "Cancel"
msgstr "Annuler"

msgid "Selected"
msgstr "Sélectionné"

msgid "Choose an app"
msgstr "Choisir une application"

msgid "Set this override for all refs of an installed app."
msgstr "Appliquer cette dérogation à toutes les références d’une application installée."

msgid "Add app override"
msgstr "Ajouter une dérogation d’application"

msgid "Could not save default export setting"
msgstr "Impossible d’enregistrer le paramètre d’export par défaut"

msgid "Default setting saved, but export failed"
msgstr "Paramètre par défaut enregistré, mais l’export a échoué"

msgid "Could not reset settings"
msgstr "Impossible de réinitialiser les paramètres"

msgid "Settings reset, but export failed"
msgstr "Paramètres réinitialisés, mais l’export a échoué"

msgid "Settings reset, but overrides could not be refreshed"
msgstr "Paramètres réinitialisés, mais les dérogations n’ont pas pu être actualisées"

msgid "Reset settings?"
msgstr "Réinitialiser les paramètres ?"

msgid "This restores the default export policy and clears app overrides. Alias-specific settings and custom aliases are not changed."
msgstr "Cette action rétablit la règle d’export par défaut et supprime les dérogations des applications. Les paramètres propres aux alias et les alias personnalisés ne sont pas modifiés."

msgid "Could not confirm settings reset"
msgstr "Impossible de confirmer la réinitialisation des paramètres"

msgid "Could not load app overrides"
msgstr "Impossible de charger les dérogations des applications"

msgid "About"
msgstr "À propos"
