#!/usr/bin/make -f

%:
	dh $@ --buildsystem=pybuild

override_dh_auto_test:
ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	@echo "Skipping tests (DEB_BUILD_OPTIONS=nocheck)."
else
	PYTHONPATH=src python3 -m unittest discover -s tests -v
endif

override_dh_auto_build:
	$(MAKE) translations
	$(MAKE) completion
	dh_auto_build

override_dh_installsystemd:
	dh_installsystemd -pflatpak-command-exporter flatpak-command-exporter-system.timer
